# Keep both sides when two people append at once, instead of raising a conflict.
# Without this, two ideas added at the same time collide at the end of the file and
# one person's entry gets lost during the rebase — the worst possible failure here.
IDEAS.md merge=union
CONTEXT.md merge=union
JOURNAL.md merge=union
TASKS.md merge=union

# Journey files are edited in place, not appended to. Union-merging a flowchart
# duplicates nodes and produces a diagram that renders as nonsense, so these
# conflict normally on purpose — two people rewriting the same flow should talk.
journeys/*.md -merge=union

